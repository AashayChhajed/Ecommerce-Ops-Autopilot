# ─────────────────────────────────────────────────────────────
# E-Commerce Ops Autopilot — Backend environment variables
# Copy to backend/.env (or repo root .env) and fill in values.
# On Render these are set in the dashboard / render.yaml instead.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ──────────────────────────────────────
# Local: use host/port/db/user/password. Cloud (Render/Neon/Supabase):
# set DATABASE_URL (TLS is enabled automatically when DATABASE_URL is set).
# There is NO hardcoded password fallback: with no DATABASE_URL the server
# refuses to start unless PGPASSWORD is set (clear startup error instead of
# a cryptic SCRAM auth failure later).
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce_ops_autopilot
PGUSER=postgres
PGPASSWORD=your-password-here

# ── Server ─────────────────────────────────────────────────────
PORT=4000
# Comma-separated origins allowed by CORS. Use your deployed frontend
# URL on Render, e.g. https://ecommerce-ops-autopilot.vercel.app
CORS_ORIGIN=http://localhost:3000
# Max JSON request body size in bytes (default 1 MiB = 1048576)
# MAX_BODY_BYTES=1048576

# ── API authentication (Phase 2) ─────────────────────────────
# Protects all mutation/admin/operational endpoints via the X-API-Key header.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave EMPTY in local dev to disable auth (a warning is printed).
# PRODUCTION FAILS CLOSED: when NODE_ENV=production the server refuses to
# start without this key (and rejects requests even if startup is bypassed).
# render.yaml sets NODE_ENV=production and wires this secret from the Render
# dashboard — production can never deploy with an unprotected API.
# NEVER hardcode a real key, never commit it, and never expose it to the
# frontend bundle — the Next.js app proxies requests through a server route.
AUTOPILOT_API_KEY=
# NODE_ENV=production   # set automatically by render.yaml; enables fail-closed
#                        # auth and masks unexpected error messages

# ── Scheduler (cron jobs) ──────────────────────────────────────
# AUTOPILOT_DISABLE_SCHEDULER=1   # disables in-process cron (e.g. for a stateless web service)
# AUTOPILOT_SCHEDULER_ONLY=1      # run ONLY the scheduler, no HTTP server (Render background worker)

# ── Shopify sync ───────────────────────────────────────────────
SHOPIFY_SHOP_NAME=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxx
SHOPIFY_API_VERSION=2024-04
# SHOPIFY_FETCH_TIMEOUT_MS=30000   # per-request timeout (Phase 1)
# SHOPIFY_MAX_RETRIES=3            # attempts per request; retries ONLY 429/5xx/network/timeout
# SHOPIFY_MAX_PAGES=20             # pagination safety cap per sync
# SHOPIFY_PAGE_LIMIT=250           # page size (Shopify max 250)
# SHOPIFY_SYNC_ENABLED=false       # disable scheduled Shopify syncs
# SHOPIFY_PRODUCT_LIMIT=250
# SHOPIFY_SYNC_BACKOFF_MS=1800000

# ── Shopify webhooks (Phase 3) ─────────────────────────────────
# The signing secret from your Shopify app / webhook configuration. Shopify
# signs each delivery with HMAC-SHA256 over the RAW request body; the receiver
# verifies it before processing and FAILS CLOSED when this is unset.
# NEVER commit a real value, never expose it to the frontend, and note that the
# X-API-Key is NOT used for webhooks — HMAC is the only accepted credential.
# Webhook endpoint: POST /api/webhooks/shopify
SHOPIFY_WEBHOOK_SECRET=
# WEBHOOK_MAX_RETRIES=5             # attempts before an event is marked FAILED
# WEBHOOK_RETRY_BASE_MS=30000      # first backoff step (30s), exponential + jitter
# WEBHOOK_RETRY_MAX_MS=900000      # backoff ceiling (15min)
# WEBHOOK_MAX_EVENTS_PER_RUN=50    # events claimed per worker run
# WEBHOOK_PROCESSING_STALE_MS=300000  # crashed-claim recovery (5min)
# AUTOPILOT_WEBHOOK_INLINE_PROCESSING=0  # persist + ack only; let the cron worker drain

# ── Notification retries (Phase 2, restart-safe) ─────────────
# NOTIFICATION_MAX_RETRIES=5          # attempts before FAILED
# NOTIFICATION_RETRY_BASE_MS=30000    # first backoff step (30s)
# NOTIFICATION_RETRY_MAX_MS=900000    # backoff ceiling (15min)
# NOTIFICATION_BATCH_LIMIT=50         # orders claimed per worker run
# NOTIFICATION_PROCESSING_STALE_MS=300000  # crashed-claim recovery (5min)

# ── AI generation (Phase 2) ──────────────────────────────────
# AI_MAX_CONCURRENCY=3             # parallel Gemini calls per batch (1-10)

# ── Multi-channel internals (Phase 2) ────────────────────────
# CHANNEL_ID_CACHE_TTL_MS=60000    # channel id cache TTL (default 60s)

# ── AI Description Generation (Gemini) ─────────────────────────
# Without a key, the backend generates mock descriptions (dev mode).
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
# GEMINI_API_VERSION=v1beta
# GEMINI_MIN_REQUEST_INTERVAL_MS=15000   # throttle (default 15s)
# GEMINI_REQUEST_TIMEOUT_MS=45000

# ── Email (Mailtrap sandbox) ───────────────────────────────────
# Without SMTP creds the service falls back to mock/console mode.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_FROM_EMAIL=noreply@wesee-autopilot.com
MAILTRAP_FROM_NAME=WeSee Autopilot
# Recipient for low-stock alerts + "View in Dashboard" link in emails:
ADMIN_EMAIL=admin@example.com
ADMIN_PANEL_URL=http://localhost:3000

# ── Safety buffer (over-order guard) ───────────────────────────
# SAFETY_BUFFER_PERCENT=100  # % of warehouse stock considered sellable (1..100)

# ── Test-only flags (do not set in production) ─────────────────
# EMAIL_MOCK_MODE=1          # force mock email delivery
# AUTOPILOT_SKIP_START=1     # prevent server auto-start (used by the test suite)
